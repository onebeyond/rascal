{
  "name": "rascal",
  "version": "22.0.0",
  "description": "An advanced RabbitMQ / AMQP client built on amqplib",
  "main": "index.js",
  "dependencies": {
    "async": "^3.2.6",
    "debug": "^4.4.3",
    "forward-emitter": "^0.1.1",
    "generic-pool": "^3.9.0",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "stashback": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "amqplib": "^2.4.0",
    "lefthook": "^2.2.2",
    "random-readable": "^1.0.1"
  },
  "peerDependencies": {
    "amqplib": ">=0.5.5"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-force-exit --experimental-test-isolation=none --test-timeout=120000 --test-reporter=spec 'test/**/*.tests.js'",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --error-on-warnings --write .",
    "coverage": "mkdir -p coverage && node --test --test-force-exit --experimental-test-isolation=none --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --experimental-test-coverage --test-coverage-include='index.js' --test-coverage-include='lib/**' 'test/**/*.tests.js'",
    "docker": "docker run -d --name rascal-rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:4-management-alpine",
    "prepare": "lefthook install"
  },
  "keywords": [
    "rabbitmq",
    "rabbit",
    "amqplib",
    "amqp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/onebeyond/rascal.git"
  },
  "bugs": {
    "url": "https://github.com/onebeyond/rascal/issues"
  },
  "homepage": "https://onebeyond.github.io/rascal/",
  "author": "Stephen Cresswell",
  "license": "MIT"
}
